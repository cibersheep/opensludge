  <menu id="menubar1-model"><submenu><attribute name="label" translatable="yes">_File</attribute><section><item><attribute name="label">_New</attribute><attribute name="action">win.new</attribute><attribute name="icon">document-new</attribute></item><item><attribute name="label">_Open</attribute><attribute name="action">win.open</attribute><attribute name="icon">document-open</attribute></item><item><attribute name="label">_Save</attribute><attribute name="action">win.save</attribute><attribute name="icon">document-save</attribute></item><item><attribute name="label">_Save As</attribute><attribute name="action">win.save-as</attribute><attribute name="icon">document-save-as</attribute></item></section><section><item><attribute name="label">_Quit</attribute><attribute name="action">win.quit</attribute><attribute name="icon">application-exit</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">_Edit</attribute><section><item><attribute name="label">_Preferences</attribute><attribute name="action">win.preferences</attribute><attribute name="icon">emblem-system</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">_Project</attribute><section><item><attribute name="label">_Properties</attribute><attribute name="action">win.project-settings</attribute><attribute name="icon">document-properties</attribute></item><item><attribute name="label" translatable="yes">_Compile</attribute><attribute name="action">win.compile</attribute><attribute name="icon">system-run</attribute></item><item><attribute name="label" translatable="yes">_Run Game</attribute><attribute name="action">win.comp-gamebutton</attribute><attribute name="icon">media-playback-start</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">P_rograms</attribute><section><item><attribute name="label" translatable="yes">Launch _Floor Maker</attribute><attribute name="action">win.floormaker</attribute><attribute name="icon">sludge-floormaker</attribute></item><item><attribute name="label" translatable="yes">Launch _Sprite Bank Editor</attribute><attribute name="action">win.spritebankeditor</attribute><attribute name="icon">sludge-spritebankeditor</attribute></item><item><attribute name="label" translatable="yes">Launch _Z-Buffer Maker</attribute><attribute name="action">win.zbuffermaker</attribute><attribute name="icon">sludge-zbuffermaker</attribute></item><item><attribute name="label" translatable="yes">Launch _Translation Editor</attribute><attribute name="action">win.translationeditor</attribute><attribute name="icon">sludge-translationeditor</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">_Help</attribute><section><item><attribute name="label">A_bout</attribute><attribute name="action">win.about</attribute><attribute name="icon">help-about</attribute></item></section></submenu></menu><object class="GtkWindow" id="window1">
    <property name="title" translatable="yes">SLUDGE Project Manager</property>
    <property name="default_width">520</property>
    <property name="default_height">580</property>
    <signal name="close-request" handler="on_window1_close_request" />
    <child>
