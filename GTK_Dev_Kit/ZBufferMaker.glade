<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  
  <menu id="menubar1-model"><submenu><attribute name="label" translatable="yes">_File</attribute><section><item><attribute name="label">_New from TGA image</attribute><attribute name="action">win.new</attribute><attribute name="icon">document-new</attribute></item><item><attribute name="label">_Open</attribute><attribute name="action">win.open</attribute><attribute name="icon">document-open</attribute></item><item><attribute name="label">_Save</attribute><attribute name="action">win.save</attribute><attribute name="icon">document-save</attribute></item><item><attribute name="label">_Save As</attribute><attribute name="action">win.save-as</attribute><attribute name="icon">document-save-as</attribute></item></section><section><item><attribute name="label">_Quit</attribute><attribute name="action">win.quit</attribute><attribute name="icon">application-exit</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">_Help</attribute><section><item><attribute name="label">A_bout</attribute><attribute name="action">win.about</attribute><attribute name="icon">help-about</attribute></item></section></submenu></menu><object class="GtkWindow" id="window1">
    <property name="title" translatable="yes">SLUDGE Z-Buffer Maker</property>
    <property name="default_width">680</property>
    <property name="default_height">580</property>
    <signal name="close-request" handler="on_window1_close_request" />
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPopoverMenuBar" id="menubar1">
            <property name="visible">True</property><property name="menu-model">menubar1-model</property></object>
          </child>
        <child>
          <object class="GtkBox" id="toolbar1">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property><property name="spacing">4</property><child><object class="GtkButton" id="zoom_100"><property name="visible">True</property><property name="label">100%</property><property name="tooltip-text">Show at normal size</property><signal name="clicked" handler="on_zoom_100_clicked" /></object></child><child><object class="GtkButton" id="zoom_fit"><property name="visible">True</property><property name="label">Fit</property><property name="tooltip-text">Fit to window</property><signal name="clicked" handler="on_zoom_fit_clicked" /></object></child><child><object class="GtkSeparator"><property name="visible">True</property><property name="orientation">vertical</property></object></child><child><object class="GtkLabel" id="label1">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Layer:</property>
                  </object>
                </child><child><object class="GtkScale" id="hscale">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="adjustment">slider_adjustment</property>
                    <property name="digits">0</property>
                    <property name="value_pos">right</property>
                    <signal name="value_changed" handler="on_hscale_value_changed" />
                  <property name="orientation">horizontal</property></object>
                </child><child><object class="GtkLabel" id="label2">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes"> of</property>
                  </object>
                </child><child><object class="GtkLabel" id="num_buffers_label">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">0</property>
                  </object>
                </child><child><object class="GtkSeparator"><property name="visible">True</property><property name="orientation">vertical</property></object></child><child><object class="GtkLabel" id="label4">
                    <property name="visible">True</property>
                    <property name="tooltip_text" translatable="yes">Characters will be drawn in front of this layer if they are further down the screen than y(z).</property>
                    <property name="label" translatable="yes">y(z):</property>
                  </object>
                </child><child><object class="GtkSpinButton" id="spinbutton">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">Characters will be drawn in front of this layer if they are further down the screen than y(z).</property>
                    <property name="adjustment">y_adjustment</property>
                    <signal name="value_changed" handler="on_spinbutton_value_changed" />
                  </object>
                </child></object>
          </child>
        <child>
          <object class="GtkViewport" id="viewport1">
            <property name="visible">True</property>
            <child>
              <object class="GtkGLArea" id="drawingarea1">
                <property name="visible">True</property>
                <signal name="realize" handler="on_drawingarea1_realize" />
                <signal name="render" handler="on_drawingarea1_render" />
                </object>
            </child>
          </object>
          </child>
        <child>
          <object class="GtkBox" id="statusbar">
            <property name="visible">True</property>
            <property name="spacing">2</property>
            <child>
              <object class="GtkLabel" id="cursorx_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label1">
                <property name="label" translatable="yes">, </property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="cursory_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label2">
                <property name="label" translatable="yes">  </property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="picw_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label3">
                <property name="label" translatable="yes">x</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="pich_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="zmul_label">
                <property name="label" translatable="yes">100</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label4">
                <property name="label" translatable="yes">%</property>
              </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="slider_adjustment">
    <property name="lower">1</property>
    <property name="upper">1</property>
    <property name="step_increment">0.59999999999999998</property>
    <property name="page_increment">1</property>
  </object>
  <object class="GtkImage" id="image1">
    <property name="visible">True</property>
    <property name="icon-size">1</property>
  </object>
  <object class="GtkAdjustment" id="y_adjustment">
    <property name="step_increment">1</property>
  </object>
</interface>