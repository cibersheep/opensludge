<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  
  <menu id="menubar1-model"><submenu><attribute name="label" translatable="yes">_File</attribute><section><item><attribute name="label">_New</attribute><attribute name="action">win.new</attribute><attribute name="icon">document-new</attribute></item><item><attribute name="label">_Open</attribute><attribute name="action">win.open</attribute><attribute name="icon">document-open</attribute></item><item><attribute name="label">_Save</attribute><attribute name="action">win.save</attribute><attribute name="icon">document-save</attribute></item><item><attribute name="label">_Save As</attribute><attribute name="action">win.save-as</attribute><attribute name="icon">document-save-as</attribute></item></section><section><item><attribute name="label">_Quit</attribute><attribute name="action">win.quit</attribute><attribute name="icon">application-exit</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">_Help</attribute><section><item><attribute name="label">A_bout</attribute><attribute name="action">win.about</attribute><attribute name="icon">help-about</attribute></item></section></submenu></menu><object class="GtkWindow" id="window1">
    <property name="title" translatable="yes">SLUDGE Floor Maker</property>
    <property name="default_width">680</property>
    <property name="default_height">580</property>
    <signal name="close-request" handler="on_window1_close_request" />
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPopoverMenuBar" id="menubar1">
            <property name="visible">True</property><property name="menu-model">menubar1-model</property></object>
          </child>
        <child>
          <object class="GtkBox" id="toolbar1">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property><property name="spacing">4</property><child><object class="GtkButton" id="filechooserbutton">
                    <property name="visible">True</property>
                    <property name="tooltip_text" translatable="yes">Load backdrop</property>
                    <property name="label">Load Backdrop</property><signal name="clicked" handler="on_load_backdrop_clicked" /></object>
                </child><child><object class="GtkSeparator"><property name="visible">True</property><property name="orientation">vertical</property></object></child><child><object class="GtkButton" id="zoom_100"><property name="visible">True</property><property name="label">100%</property><property name="tooltip-text">Show backdrop at its normal size</property><signal name="clicked" handler="on_zoom_100_clicked" /></object></child><child><object class="GtkButton" id="zoom_fit"><property name="visible">True</property><property name="label">Fit</property><property name="tooltip-text">Fit backdrop to window</property><signal name="clicked" handler="on_zoom_fit_clicked" /></object></child><child><object class="GtkSeparator"><property name="visible">True</property><property name="orientation">vertical</property></object></child><child><object class="GtkColorButton" id="colorbutton">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="tooltip_text" translatable="yes">Choose color for floor outlines</property>
                    <property name="title" translatable="yes">Choose a color</property>
                    <signal name="realize" handler="on_colorbutton_realize" />
                    <signal name="color_set" handler="on_colorbutton_color_set" />
                  </object>
                </child><child><object class="GtkSeparator"><property name="visible">True</property><property name="orientation">vertical</property></object></child><child><object class="GtkLabel" id="label1">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes"> Mode: </property>
                  </object>
                </child><child><object class="GtkToggleButton" id="define_borders"><property name="visible">True</property><property name="label">Define floor borders</property><property name="tooltip-text">Define floor borders</property><signal name="toggled" handler="on_define_borders_toggled" /></object></child><child><object class="GtkToggleButton" id="move_vertices"><property name="visible">True</property><property name="label">Move vertices</property><property name="tooltip-text">Move vertices</property><property name="group">define_borders</property><signal name="toggled" handler="on_move_vertices_toggled" /></object></child><child><object class="GtkToggleButton" id="delete_vertices"><property name="visible">True</property><property name="label">Delete vertices</property><property name="tooltip-text">Delete vertices</property><property name="group">move_vertices</property><signal name="toggled" handler="on_delete_vertices_toggled" /></object></child><child><object class="GtkToggleButton" id="split_line"><property name="visible">True</property><property name="label">Split line</property><property name="tooltip-text">Split line</property><property name="group">delete_vertices</property><signal name="toggled" handler="on_split_line_toggled" /></object></child><child><object class="GtkToggleButton" id="split_floor"><property name="visible">True</property><property name="label">Split floor</property><property name="tooltip-text">Split floor</property><property name="group">split_line</property><signal name="toggled" handler="on_split_floor_toggled" /></object></child></object>
          </child>
        <child>
          <object class="GtkViewport" id="viewport1">
            <property name="visible">True</property>
            <child>
              <object class="GtkGLArea" id="drawingarea1">
                <property name="visible">True</property>
                <signal name="realize" handler="on_drawingarea1_realize" />
                <signal name="render" handler="on_drawingarea1_render" />
                </object>
            </child>
          </object>
          </child>
        <child>
          <object class="GtkBox" id="statusbar">
            <property name="visible">True</property>
            <property name="spacing">2</property>
            <child>
              <object class="GtkLabel" id="cursorx_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label1">
                <property name="label" translatable="yes">, </property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="cursory_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label2">
                <property name="label" translatable="yes">  </property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="picw_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label3">
                <property name="label" translatable="yes">x</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="pich_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="zmul_label">
                <property name="label" translatable="yes">100</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label4">
                <property name="label" translatable="yes">%</property>
              </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
      </object>
    </child>
  </object>
  <object class="GtkImage" id="image2">
    <property name="visible">True</property>
    </object>
  <object class="GtkImage" id="image1">
    <property name="visible">True</property>
    </object>
  <object class="GtkImage" id="image3">
    <property name="visible">True</property>
    </object>
  <object class="GtkImage" id="image4">
    <property name="visible">True</property>
    </object>
  <object class="GtkImage" id="image5">
    <property name="visible">True</property>
    </object>
</interface>