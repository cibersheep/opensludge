<?xml version='1.0' encoding='utf-8'?>
<interface>
  <requires lib="gtk" version="4.0" />
  
  <menu id="menubar1-model"><submenu><attribute name="label" translatable="yes">_File</attribute><section><item><attribute name="label">_New</attribute><attribute name="action">win.new</attribute><attribute name="icon">document-new</attribute></item><item><attribute name="label">_Open</attribute><attribute name="action">win.open</attribute><attribute name="icon">document-open</attribute></item><item><attribute name="label">_Save</attribute><attribute name="action">win.save</attribute><attribute name="icon">document-save</attribute></item><item><attribute name="label">_Save As</attribute><attribute name="action">win.save-as</attribute><attribute name="icon">document-save-as</attribute></item></section><section><item><attribute name="label" translatable="yes">Fontify</attribute><attribute name="action">win.fontify</attribute><attribute name="icon">font-x-generic</attribute></item></section><section><item><attribute name="label">_Quit</attribute><attribute name="action">win.quit</attribute><attribute name="icon">application-exit</attribute></item></section></submenu><submenu><attribute name="label" translatable="yes">_Help</attribute><section><item><attribute name="label">A_bout</attribute><attribute name="action">win.about</attribute><attribute name="icon">help-about</attribute></item></section></submenu></menu><object class="GtkWindow" id="window1">
    <property name="title" translatable="yes">SLUDGE Sprite Bank Editor</property>
    <property name="default_width">680</property>
    <property name="default_height">580</property>
    <signal name="close-request" handler="on_window1_close_request" />
    <child>
      <object class="GtkBox" id="vbox1">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkPopoverMenuBar" id="menubar1">
            <property name="visible">True</property><property name="menu-model">menubar1-model</property></object>
          </child>
        <child>
          <object class="GtkBox" id="hbox1">
            <property name="visible">True</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkBox" id="vbox2">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkViewport" id="viewport1">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkGLArea" id="drawingarea1">
                        <property name="visible">True</property>
                        <signal name="realize" handler="on_drawingarea1_realize" />
                        <signal name="render" handler="on_drawingarea1_render" />
                        </object>
                    </child>
                  </object>
                  </child>
                <child>
                  <object class="GtkBox" id="hbox4">
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkButton" id="zoom_100">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Show at normal size</property>
                        <signal name="clicked" handler="on_zoom_100_clicked" />
                        </object>
                      </child>
                    <child>
                      <object class="GtkButton" id="zoom_fit">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">Fit to window</property>
                        <signal name="clicked" handler="on_zoom_fit_clicked" />
                        </object>
                      </child>
                    <child>
                      <object class="GtkSeparator" id="vseparator1">
                        <property name="visible">True</property>
                        <property name="orientation">vertical</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkScale" id="hscale">
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <property name="adjustment">slider_adjustment</property>
                        <property name="digits">0</property>
                        <property name="value_pos">right</property>
                        <signal name="value_changed" handler="on_hscale_value_changed" />
                      <property name="orientation">horizontal</property></object>
                      </child>
                    <child>
                      <object class="GtkLabel" id="label2">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes"> of</property>
                      </object>
                      </child>
                    <child>
                      <object class="GtkLabel" id="num_sprites_label">
                        <property name="visible">True</property>
                        <property name="label" translatable="yes">0</property>
                      </object>
                      </child>
                  <property name="orientation">horizontal</property></object>
                  </child>
              </object>
              </child>
            <child>
              <object class="GtkBox" id="vbox3">
                <property name="visible">True</property>
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <child>
                  <object class="GtkCheckButton" id="show_box">
                    <property name="label" translatable="yes">Show sprite size</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <signal name="toggled" handler="on_show_box_toggled" />
                  </object>
                  </child>
                <child>
                  <object class="GtkSeparator" id="hseparator1">
                    <property name="visible">True</property>
                  <property name="orientation">horizontal</property></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="label3">
                    <property name="visible">True</property>
                    <property name="label" translatable="yes">Hotspot:</property>
                  </object>
                  </child>
                <child>
                  <object class="GtkGrid" id="table1">
                    <property name="visible">True</property>
                    <property name="column-spacing">6</property>
                    <property name="row-spacing">6</property>
                    <child>
                      <object class="GtkBox" id="hbox2">
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkLabel" id="label5">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">x </property>
                          </object>
                          </child>
                        <child>
                          <object class="GtkSpinButton" id="x_spinbutton">
                            <property name="visible">True</property>
                            <property name="can_focus">True</property>
                            <property name="adjustment">x_adjustment</property>
                            <signal name="value_changed" handler="on_x_spinbutton_value_changed" />
                          </object>
                          </child>
                      <property name="orientation">horizontal</property></object>
                    </child>
                    <child>
                      <object class="GtkBox" id="hbox3">
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkLabel" id="label6">
                            <property name="visible">True</property>
                            <property name="label" translatable="yes">y </property>
                          </object>
                          </child>
                        <child>
                          <object class="GtkSpinButton" id="y_spinbutton">
                            <property name="visible">True</property>
                            <property name="can_focus">True</property>
                            <property name="adjustment">y_adjustment</property>
                            <signal name="value_changed" handler="on_y_spinbutton_value_changed" />
                          </object>
                          </child>
                      <property name="orientation">horizontal</property><layout><property name="column">1</property><property name="row">0</property><property name="column-span">1</property><property name="row-span">1</property></layout></object>
                      </child>
                    <child>
                      <object class="GtkButton" id="centre_hotspot">
                        <property name="label" translatable="yes">Centre</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <signal name="clicked" handler="on_centre_hotspot_clicked" />
                      <layout><property name="column">0</property><property name="row">1</property><property name="column-span">1</property><property name="row-span">1</property></layout></object>
                      </child>
                    <child>
                      <object class="GtkButton" id="base_hotspot">
                        <property name="label" translatable="yes">Base</property>
                        <property name="visible">True</property>
                        <property name="can_focus">True</property>
                        <signal name="clicked" handler="on_base_hotspot_clicked" />
                      <layout><property name="column">1</property><property name="row">1</property><property name="column-span">1</property><property name="row-span">1</property></layout></object>
                      </child>
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="multi_hotspot">
                    <property name="label" translatable="yes">Apply to range...</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <signal name="clicked" handler="on_multi_hotspot_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkSeparator" id="hseparator2">
                    <property name="visible">True</property>
                  <property name="orientation">horizontal</property></object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="mode_pal_open">
                    <property name="label" translatable="yes">Palette (open)</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="active">True</property>
                    <signal name="toggled" handler="on_mode_pal_open_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="mode_pal_closed">
                    <property name="label" translatable="yes">Palette (locked)</property>
                    <property name="visible">True</property>
                    <property name="sensitive">False</property>
                    <property name="can_focus">True</property>
                    <property name="group">mode_pal_open</property>
                    <signal name="toggled" handler="on_mode_pal_closed_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkCheckButton" id="mode_pal_none">
                    <property name="label" translatable="yes">32-bit colour</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="group">mode_pal_closed</property>
                    <signal name="toggled" handler="on_mode_pal_none_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkSeparator" id="hseparator3">
                    <property name="visible">True</property>
                  <property name="orientation">horizontal</property></object>
                  </child>
                <child>
                  <object class="GtkButton" id="insert_sprite">
                    <property name="label" translatable="yes">Insert Sprite(s)...</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <signal name="clicked" handler="on_insert_sprite_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="replace_sprite">
                    <property name="label" translatable="yes">Replace Sprite(s)...</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <signal name="clicked" handler="on_replace_sprite_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="delete_sprite">
                    <property name="label" translatable="yes">Delete Sprite</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <signal name="clicked" handler="on_delete_sprite_clicked" />
                  </object>
                  </child>
                <child>
                  <object class="GtkButton" id="export_sprite">
                    <property name="label" translatable="yes">Export Sprite as...</property>
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <signal name="clicked" handler="on_export_sprite_clicked" />
                  </object>
                  </child>
              </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
        <child>
          <object class="GtkBox" id="statusbar">
            <property name="visible">True</property>
            <property name="spacing">2</property>
            <child>
              <object class="GtkLabel" id="cursorx_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label1">
                <property name="label" translatable="yes">, </property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="cursory_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label2">
                <property name="label" translatable="yes">  </property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="picw_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label3">
                <property name="label" translatable="yes">x</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="pich_label">
                <property name="label" translatable="yes">0</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="zmul_label">
                <property name="label" translatable="yes">100</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="status_label4">
                <property name="label" translatable="yes">%</property>
              </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
      </object>
    </child>
  </object>
  <object class="GtkAdjustment" id="slider_adjustment">
    <property name="step_increment">0.59999999999999998</property>
    <property name="page_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="x_adjustment">
    <property name="lower">-2000</property>
    <property name="upper">2000</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkAdjustment" id="y_adjustment">
    <property name="lower">-2000</property>
    <property name="upper">2000</property>
    <property name="step_increment">1</property>
  </object>
  <object class="GtkImage" id="image1">
    <property name="visible">True</property>
    </object>
  <object class="GtkDialog" id="fontify_dialog">
    <property name="title" translatable="yes">Fontify...</property>
    <signal name="close-request" handler="on_fontify_dialog_close_request" />
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="hbox5">
            <property name="visible">True</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkSpinButton" id="fontify_width">
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                <property name="adjustment">fontify_adjustment</property>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="label1">
                <property name="visible">True</property>
                <property name="label" translatable="yes">Width of space character that will be added to the end of the font.</property>
                </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
        </object>
    </child>
    <action-widgets>
      <action-widget response="-6">button1</action-widget>
      <action-widget response="-5">button2</action-widget>
    </action-widgets>
  <child internal-child="action_area">
          <object class="GtkBox" id="dialog-action_area1">
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="button1">
                <property name="label">gtk-cancel</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                </object>
              </child>
            <child>
              <object class="GtkButton" id="button2">
                <property name="label">gtk-ok</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
      </object>
  <object class="GtkAdjustment" id="fontify_adjustment">
    <property name="value">1</property>
    <property name="lower">1</property>
    <property name="upper">1000</property>
    <property name="step_increment">1</property>
    <property name="page_increment">10</property>
  </object>
  <object class="GtkDialog" id="multi_dialog">
    <property name="title" translatable="yes">Apply hotspot to range</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox3">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">2</property>
        <child>
          <object class="GtkBox" id="hbox6">
            <property name="visible">True</property>
            <property name="spacing">12</property>
            <child>
              <object class="GtkGrid" id="table2">
                <property name="visible">True</property>
                <property name="column-spacing">12</property>
                <property name="row-spacing">12</property>
                <child>
                  <object class="GtkSpinButton" id="multi_from">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="adjustment">multi_from_adjustment</property>
                  <layout><property name="column">1</property><property name="row">0</property><property name="column-span">1</property><property name="row-span">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkSpinButton" id="multi_to">
                    <property name="visible">True</property>
                    <property name="can_focus">True</property>
                    <property name="adjustment">multi_to_adjustment</property>
                  <layout><property name="column">1</property><property name="row">1</property><property name="column-span">1</property><property name="row-span">1</property></layout></object>
                  </child>
                <child>
                  <object class="GtkLabel" id="label7">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">From:</property>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="label8">
                    <property name="visible">True</property>
                    <property name="xalign">0</property>
                    <property name="label" translatable="yes">To:</property>
                  <layout><property name="column">0</property><property name="row">1</property><property name="column-span">1</property><property name="row-span">1</property></layout></object>
                  </child>
              </object>
              </child>
            <child>
              <object class="GtkLabel" id="label4">
                <property name="visible">True</property>
                <property name="label" translatable="yes">This will copy the hotspot coordinates from the current frame to the selected range of frames.</property>
                </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
        </object>
    </child>
    <action-widgets>
      <action-widget response="-6">button3</action-widget>
      <action-widget response="-5">button4</action-widget>
    </action-widgets>
  <child internal-child="action_area">
          <object class="GtkBox" id="dialog-action_area3">
            <property name="visible">True</property>
            <child>
              <object class="GtkButton" id="button3">
                <property name="label">gtk-cancel</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                </object>
              </child>
            <child>
              <object class="GtkButton" id="button4">
                <property name="label">gtk-ok</property>
                <property name="visible">True</property>
                <property name="can_focus">True</property>
                </object>
              </child>
          <property name="orientation">horizontal</property></object>
          </child>
      </object>
  <object class="GtkAdjustment" id="multi_from_adjustment">
    <property name="upper">100</property>
    <property name="step_increment">1</property>
    <property name="page_increment">10</property>
  </object>
  <object class="GtkAdjustment" id="multi_to_adjustment">
    <property name="upper">100</property>
    <property name="step_increment">1</property>
    <property name="page_increment">10</property>
  </object>
</interface>